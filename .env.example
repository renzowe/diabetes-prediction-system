# Usadas por docker-compose para crear la base de datos PostgreSQL
DB_USER=MI_USUARIO
DB_PASSWORD=MI_CONTRASENA
DB_NAME=MI_NOMBRE_BASE_DATOS

# Usadas por el backend
DATABASE_URL=postgresql://MI_USUARIO:MI_CONTRASENA@db:5432/MI_NOMBRE_BASE_DATOS
API_KEY=MI_CLAVE_API
# Opcionales (valores por defecto entre parentesis)
# MODELS_DIR=models/v2            (carpeta con los modelos congelados y seleccion.json)
# CORS_ORIGINS=["*"]              (origenes permitidos, en formato JSON)
